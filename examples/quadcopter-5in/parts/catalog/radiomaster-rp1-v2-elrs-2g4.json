      "traits": [
        {
          "params": {
            "note": "CRSF framing over full-duplex UART; the flight controller assigns serial RX to one of its UARTs in firmware.",
            "protocol": "crsf"
          },
          "type": "serial_rx_protocol"
        },
        {
          "params": {
            "note": "Crossover to the FC UART: receiver TX -> FC RX, receiver RX -> FC TX (same UART number). Avoid FC UARTs with SBUS pull-downs on RX (can hold the receiver in bootloader). In Betaflight: Ports tab -> enable Serial RX on that UART; Configuration/Receiver -> Serial-based receiver, provider CRSF.",
            "source": [
              "https://www.expresslrs.org/quick-start/receivers/wiring-up/",
              "https://cdn.shopify.com/s/files/1/0609/8324/7079/files/RP1_User_Manual.pdf?v=1722923320"
            ]
          },
          "type": "usage_note"
        },
        {
          "params": {
            "note": "Leave UART baud at the default 420000; set 400000 only for KISS/KISS Ultra flight controllers.",
            "source": "https://www.expresslrs.org/quick-start/webui/"
          },
          "type": "usage_note"
