    {
      "params": {
        "note": "Package includes '1 * CRSF wire' (product page); the manual card lists silicone wires and the product photo shows four (red, black, white, green) twisted together with bare tinned ends and no plug. Their gauge, length and colour-to-pad assignment are not stated.",
        "source": [
          "https://radiomasterrc.com/products/rp1-expresslrs-2-4ghz-nano-receiver",
          "https://flymod.net/download/radiomaster_receiver_rp1_v2_manual"
