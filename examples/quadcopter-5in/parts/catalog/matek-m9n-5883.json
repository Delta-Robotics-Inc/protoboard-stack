  "description": "Matek Systems M9N-5883 GNSS and compass module: u-blox NEO-M9N concurrent receiver (GPS, GLONASS, Galileo, BeiDou) with a 25x25x4 mm patch antenna, plus a QMC5883P (0x2C; QMC5883L 0x0D on pre-2026 units) magnetometer on I2C. 4-5.5 V input, 50 mA, UART at 38400 baud default, two JST-GH-6P connectors, 32x32x10 mm, 14.5 g. Matek's current replacement for the EOL M10Q-5883.",
  "domains": [
    {
      "domain": "electrical",
      "metadata": {
        "supply_current_mA": 50,
        "supply_current_note": "\"Power consumption: 50mA\" (Matek Specifications)."
      },
      "power_domains": [
        {
          "id": "vin_5v",
          "max_current_mA": 50,
          "name": "5V input",
          "nominal_voltage_V": 5,
          "voltage_range_V": [
            4,
            5.5
          ]
        }
      ]
    },
    {
      "dimensions_mm": {
        "height": 10,
        "length": 32,
        "width": 32
      },
      "domain": "mechanical",
      "metadata": {
        "cad": "M9N-5883_step.zip (STEP model linked from the Matek product page)",
        "corner_radius_mm": 3,
        "mounting_holes": "4x Φ2 mm, 26 mm spacing",
        "patch_antenna_mm": [
          25,
          25,
          4
        ]
      },
      "weight_g": 14.5
    },
    {
      "domain": "thermal",
      "operating_temperature_C": [
        -20,
        80
      ]
    },
    {
      "domain": "network",
      "metadata": {
        "antenna": "integrated 25x25x4 mm patch (Cirocomm PA025AZ0009, formerly Taoglas), no external antenna connector",
        "constellations": [
          "GPS",
          "GLONASS",
          "Galileo",
          "BeiDou"
        ],
        "gnss_receiver": "u-blox NEO-M9N"
      }
    }
  ],
