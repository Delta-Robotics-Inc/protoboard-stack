            "source": [
              "https://www.dji.com/o4-air-unit/specs",
              "https://dl.djicdn.com/downloads/DJI_O4_Air_Unit_Series/UM/DJI_O4_Air_Unit_Series_User_Manual_v1.0_en.pdf"
