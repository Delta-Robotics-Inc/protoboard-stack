  "traits": [
    {
      "params": {
        "fastener_type": "heat-set threaded insert for thermoplastics",
        "installation": "heat (soldering iron) or ultrasound; blind or through holes; reusable (can be removed and reinserted)",
        "kind": "fastener",
        "length_mm": 4,
        "material": "brass",
        "source": [
          "https://www.ruthex.de/en/products/ruthex-gewindeeinsatz-m2-70-stuck-rx-m2x4-messing-gewindebuchsen",
          "https://www.ruthex.de/en/products/ruthex-gewindeeinsatz-m2-70-stuck-rx-m2x4-messing-gewindebuchsen.json",
          "https://www.3djake.com/ruthex/threaded-insert-m2-70-pieces"
        ],
        "thread": "M2"
      },
      "type": "performance"
    },
    {
      "params": {
        "note": "Host design: Ø3.2 mm hole (D3) with at least 1.3 mm of wall around it (W min), blind or through. ruthex gives the blind-hole depth as L + 1 mm min, 5.0 mm for this insert. ruthex gives no iron temperature; general heat-set guidance from CNC Kitchen (a different insert maker) is an iron 10-20 °C above the print temperature (about 245 °C for PETG). Set the insert with its entry face flush with the host face. With an M2 x 6 screw, a clamped part thinner than 2.0 mm lets the screw pass the insert's far end, which needs that clearance below it.",
        "source": [
          "https://cdn.shopify.com/s/files/1/0567/7019/9760/files/1Tabelle.PT05_eb2a30fa-5c34-46f8-b557-a6c432354560.jpg?v=1748341911",
          "https://cdn.shopify.com/s/files/1/0567/7019/9760/files/out-50xGE-M2x04-001.jpg?v=1784916330",
          "https://www.ruthex.de/en/products/ruthex-gewindeeinsatz-m2-70-stuck-rx-m2x4-messing-gewindebuchsen",
          "https://www.cnckitchen.com/blog/tipps-amp-tricks-fr-gewindeeinstze-im-3d-druck-3awey"
        ]
      },
      "type": "usage_note"
    },
    {
      "params": {
        "note": "Wearable watch: 4 inserts for the back cover fastening. Smart bottle: 6 inserts for the cap lid, on a 76 mm circle (the brief's assumption). Both with iso-7045-m2x6-a2 screws.",
        "quantity_bottle": 6,
        "quantity_watch": 4
      },
      "type": "usage_note"
    },
    {
      "params": {
        "field": "D2",
        "resolution": "D2 3.1 is recorded as the drawn pilot diameter (metadata.d2_mm and the seat trait). The generated body uses Ø3.20, as in the STEP, because the STEP is ruthex's own 3D model of this insert and gives the whole profile the body is built from, while the drawing gives one nominal value; Ø3.1 sits between the STEP's Ø3.20 pilot and its Ø3.0 end chamfer. The 0.1 mm does not change the host design, which uses D3.",
        "sources": [
          "https://cdn.shopify.com/s/files/1/0567/7019/9760/files/1Tabelle.PT05_eb2a30fa-5c34-46f8-b557-a6c432354560.jpg?v=1748341911",
          "https://cdn.shopify.com/s/files/1/0567/7019/9760/files/out-50xGE-M2x04-001.jpg?v=1784916330",
          "https://cdn.shopify.com/s/files/1/0567/7019/9760/files/ruthex_RX-M2x4.step?v=1621264078"
        ],
        "values": [
          "D2 3.1 mm (the far-end pilot, ruthex drawing and pack label)",
          "pilot Ø3.20 in the ruthex STEP (z 3.4-3.9, chamfered to Ø3.0 at the far end)"
        ]
      },
      "type": "source_discrepancy"
    },
    {
      "params": {
        "field": "manufacturer CAD",
        "note": "ruthex publishes a STEP (src_cad, from the product page and the CAD data page), but neither page states terms. ruthex's Thingiverse upload of its insert STEP set (thing:4682424) is CC BY 4.0, but its files need a login and were not compared, so the STEP was used as measured evidence only. Generated body: library/cad/py/catalog/ruthex-rx-m2x4.py.",
        "source": [
          "https://cdn.shopify.com/s/files/1/0567/7019/9760/files/ruthex_RX-M2x4.step?v=1621264078",
          "https://www.ruthex.de/en/pages/cad-daten",
          "https://www.thingiverse.com/thing:4682424"
        ]
      },
      "type": "data_gap"
    },
    {
      "params": {
        "field": "generated body",
        "reason": "Tooth count, crest and root diameters and twist rates are measured from the ruthex STEP; the tooth shape is simplified. The bore is nominal M2 (the STEP's thread runs Ø1.62 minor to Ø2.07 major) so a modelled screw shank fits it, as the library's nut does.",
        "value": "12-tooth knurl bands with a 4° flat crest and a V root at a constant twist (upper -50° over 1.0 mm, lower +40° over 0.9 mm, then a plain cone); plain Ø2.0 bore with no thread form"
      },
      "type": "assumption"
