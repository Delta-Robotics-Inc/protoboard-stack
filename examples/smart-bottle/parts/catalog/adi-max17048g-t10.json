          },
          "type": "pin_functions"
        },
        {
          "params": {
            "note": "ALRT is driven low when an enabled alert fires (low SOC at CONFIG.ATHD, default 4 %; 1 % SOC change; VCELL above VALRT.MAX or below VALRT.MIN; reset) and stays low until software writes CONFIG.ALRT = 0. Alerts are enabled at power-up. VOL <= 0.4 V at 4 mA, 20 mA continuous sink absolute maximum. Needs an external pull-up if used; leave unconnected otherwise (Table 3).",
            "source": "https://www.analog.com/media/en/technical-documentation/data-sheets/MAX17048-MAX17049.pdf (p.2, p.10 Alert Interrupt, Table 1, p.12 CONFIG, p.14-15)"
