      "traits": [
        {
          "params": {
            "note": "Constant-current / constant-voltage charge of one Li-ion or Li-polymer cell to VREG 4.20 V (4.168-4.232 V, -5 to +55 C). Fast charge current IREG = 1000 V / RPROG: 100 mA (90-110) at 10 kOhm, 505 mA (450-550) at 2 kOhm, 14.5 mA (12.5-16.5) at 67 kOhm. Options AC: precondition at 10 % of IREG while VBAT < 66.5 % of VREG; charge terminates when the current falls below 7.5 % of IREG in constant voltage; recharge starts when VBAT falls below 96.5 % of VREG.",
            "source": "https://ww1.microchip.com/downloads/aemDocuments/documents/APID/ProductDocuments/DataSheets/MCP73831-Family-Data-Sheet-DS20001984H.pdf (DC characteristics pp.3-4, §4.4-4.8 pp.13-14, Product Identification System p.26)"
          },
          "type": "usage_note"
        },
        {
