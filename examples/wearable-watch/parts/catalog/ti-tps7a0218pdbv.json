      "traits": [
        {
          "params": {
            "note": "1.5-6.0 V operating input (6.5 V absolute max). Regulation needs VIN >= VOUT(nom) + VDO: dropout at 200 mA for 1.8 V <= VOUT < 2.5 V is 400 mV max (TJ -40 to 85 C) and 450 mV max (TJ -40 to 125 C), so about 2.25 V at full load; below that the output tracks the input. The electrical characteristics are specified at VIN = 2.3 V for this output (VOUT(nom) + 0.5 V or 2.0 V, whichever is greater). UVLO 1.3 V typ rising (1.23-1.47), 1.12 V typ falling (1.0-1.41), 180 mV hysteresis. Ground current 25 nA typ / 46 nA max at 25 C with no load (60 nA max at -40 to 85 C), 25 nA in dropout; IGND/IOUT 0.25 % for 1-100 mA, 0.15 % at >= 100 mA. Shutdown 3 nA typ / 10 nA max.",
            "source": "https://www.ti.com/lit/ds/symlink/tps7a02.pdf (§6.1, §6.3, §6.5, §7.3.3, §7.4.3)"
          },
          "type": "usage_note"
        },
        {
          "params": {
            "note": "1 uF ceramic input capacitor (CIN nominal); not required for stability but recommended, and needed if the source impedance is above 0.5 ohm. Place it as close to IN as possible. X5R/X7R/C0G; expect up to 50 % derating.",
            "source": "https://www.ti.com/lit/ds/symlink/tps7a02.pdf (§6.3, §8.1.1, §8.1.2, §8.4.1)"
          },
          "type": "usage_note"
        }
      ]
