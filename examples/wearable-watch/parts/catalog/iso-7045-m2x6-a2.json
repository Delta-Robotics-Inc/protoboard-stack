  "traits": [
    {
      "params": {
        "drive": "PZ0",
        "fastener_type": "pan head screw, type Z (Pozi) cross recess",
        "kind": "fastener",
        "length_mm": 6,
        "material": "A2 stainless steel",
        "source": [
          "https://www.accu.co.uk/pozi-pan-head-screws/9242-SPP-M2-6-A2",
          "https://www.accu.co.uk/api/product-datasheet?id=9242"
        ],
        "standard": "ISO 7045 / DIN 7985 Z",
        "thread": "M2 x 0.4"
      },
      "type": "performance"
    },
    {
      "params": {
        "note": "Wearable watch: 4 per back cover. Smart bottle: 6 per lid, compressing the lid face seal. Each screw goes into a ruthex RX-M2x4 heat-set insert; the fastened part sits between head_bearing and the insert, so its thickness plus the engaged thread equals the 6 mm under-head length. Drive with a PZ0 Pozi bit (Drive Size PZ0). Quantities are from the project briefs (examples/wearable-watch/docs/component-selection.md, examples/smart-bottle/docs/component-selection.md); the joint harnesses own the stack-up and torque.",
        "quantity_per_bottle": 6,
        "quantity_per_watch": 4,
        "source": "https://www.accu.co.uk/api/product-datasheet?id=9242"
      },
      "type": "usage_note"
    },
    {
      "params": {
        "field": "head height",
        "resolution": "Accu stocks to DIN 7985 Z, whose M2 head is taller (Farnell: head H max DIN 1.7, ISO 1.6). The part and its CAD use Accu's 1.72 mm, the envelope of the screw bought; an ISO-dimensioned screw is up to 0.12 mm lower, which only adds clearance.",
        "sources": [
          "https://www.accu.co.uk/api/product-datasheet?id=9242",
          "https://cdn.standards.iteh.ai/samples/13608/caed16a7f73145ffab7712aa5196142c/ISO-7045-1994.pdf",
          "https://www.farnell.com/datasheets/11792.pdf"
        ],
        "values": [
          "1.72 mm +0/-0.26 (Accu SPP-M2-6-A2)",
          "1.60 mm max, 1.46 mm min (ISO 7045 Table 1)"
        ]
      },
      "type": "source_discrepancy"
    },
    {
      "params": {
        "field": "mass",
        "resolution": "weight_g uses Accu's stated mass for the part bought. ISO's figure is informative only.",
        "sources": [
          "https://www.accu.co.uk/api/product-datasheet?id=9242",
          "https://cdn.standards.iteh.ai/samples/13608/caed16a7f73145ffab7712aa5196142c/ISO-7045-1994.pdf"
        ],
        "values": [
          "0.19 g (Accu: 19 g per 100 units)",
          "0.233 g (ISO 7045 Table 1: 0,233 kg per 1000 pieces, steel at 7,85 kg/dm3, for information only)"
        ]
      },
      "type": "source_discrepancy"
    },
    {
      "params": {
        "field": "ISO 7045 edition",
        "reason": "ISO 7045:2011 is the current edition and was not fetched; only the 1994 text is available as a free preview. The 2011 M2 values are taken to be the same. The Accu data sheet agrees with the 1994 table on thread, pitch, head diameter and recess size.",
        "source": "https://cdn.standards.iteh.ai/samples/13608/caed16a7f73145ffab7712aa5196142c/ISO-7045-1994.pdf",
        "value": "M2 dimensions from ISO 7045:1994 (second edition)"
      },
      "type": "assumption"
    },
    {
      "params": {
        "field": "CAD simplifications",
        "reason": "ISO 7045 shows an 'as rolled end' with no dimensions, gives only m (2.1 ref) and penetration (1.17-1.42) for the type Z recess, and leaves the full recess form to ISO 4757 (not consulted). The slot width is assumed; the depth is the middle of the penetration range. None of these change the thread, bearing face or envelope the interfaces use.",
        "source": "https://cdn.standards.iteh.ai/samples/13608/caed16a7f73145ffab7712aa5196142c/ISO-7045-1994.pdf",
        "value": "plain Ø2.0 shank (thread major diameter, no thread form) with a flat end; under-head radius (r min 0.1) and transition diameter (da max 2.6) not modelled; head top radius rf = 3.2 (ISO 'approximately'); Pozi recess modelled as a plain cross of two 2.1 x 0.45 mm slots, 1.3 mm deep from the crown"
      },
      "type": "assumption"
    },
    {
      "params": {
        "field": "manufacturer CAD",
        "note": "Accu offers STL / STP / IGS models only after signing in to an Accu account; no supplier account may be used, so they were not downloaded and their terms are unknown. ISO and Farnell publish drawings only. Geometry is generated from ISO 7045 Table 1 and the Accu data sheet (library/cad/py/catalog/iso-7045-m2x6-a2.py)."
      },
      "type": "data_gap"
    },
    {
      "params": {
        "fields": [
          "tightening torque",
          "proof load / property class",
          "operating temperature",
          "recess form (ISO 4757)"
        ],
        "note": "Not stated by Accu, Farnell or the ISO 7045 preview (mechanical properties are by reference to ISO 3506, not consulted)."
