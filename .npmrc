# Peer dependencies are not installed automatically (PB-820). circuit-json-to-gerber
# names the tscircuit meta-package (the tsci CLI) as a peer; installing it brought
# nested copies of @tscircuit/core that broke resolution in this workspace. The
# peers a package needs at run time are listed in its own package.json instead
# (packages/ext-tscircuit/README.md, "Tools and versions").
legacy-peer-deps=true
