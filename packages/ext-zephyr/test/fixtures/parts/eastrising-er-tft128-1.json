          "label": "SDA (data in; also data out for reads)",
          "required": true,
          "match": {
            "protocol": "spi",
            "role": "data_in",
            "capability": "spi_mosi"
          }
        },
        {
          "id": "sck",
          "label": "SCL",
          "required": true,
          "match": {
            "protocol": "spi",
            "role": "clock",
            "capability": "spi_sck"
          }
        },
        {
          "id": "ss",
          "label": "CS (active low)",
          "required": true,
          "match": {
            "protocol": "spi",
            "role": "select",
            "capability": "spi_ss"
          }
        }
      ],
      "profiles": [
        {
          "id": "spi_fpc",
          "label": "SDA/SCL/CS on FPC pins 10/9/8",
          "bindings": {
            "mosi": "pin_10",
            "sck": "pin_9",
            "ss": "pin_8"
          }
        }
      ],
      "max_instances": 1,
      "traits": [
        {
          "type": "usage_note",
          "params": {
            "note": "4-line serial interface: D/C (pin 7) selects command (low) or data (high) for each byte and is driven from a host GPIO, as is RESET (pin 11, active low, required to initialise the chip). Write clock cycle >= 10 ns (up to 100 MHz); read clock cycle >= 150 ns (up to 6.67 MHz). SDA is bidirectional: reads need it on a bidirectional host pin; a write-only host can leave reads unused.",
            "read_max_hz": 6666666,
            "source": [
              "https://www.buydisplay.com/download/manual/ER-TFT1.28-1_Datasheet.pdf (§2.3, §4.1)",
              "https://web.archive.org/web/20250218222306/https://www.buydisplay.com/download/ic/GC9A01A.pdf (§7.3.4 Table 48)"
            ]
          }
        }
      ]
