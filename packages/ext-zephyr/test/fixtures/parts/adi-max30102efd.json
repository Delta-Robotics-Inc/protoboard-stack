      "traits": [
        {
          "type": "usage_note",
          "params": {
            "note": "VLED+ 3.1-5.0 V (3.3 V typical); 6.0 V absolute maximum to PGND. The LED drivers sink a programmed pulse current, 0-50 mA (Table 8: 0x1F 6.2 mA, 0x3F 12.6 mA, 0x7F 25.4 mA, 0xFF 51.0 mA typical; actual current varies widely with trimming), one LED per time slot, pulse width 69-411 us at 50-3200 sps; average current = pulse current x pulse width x sample rate per active LED. Application circuit: +3.3 V rail sized 200 mA max, 10 uF + 0.1 uF to PGND. GND to PGND within +-0.3 V.",
            "source": "https://download.mikroe.com/documents/datasheets/MAX30102_datasheet.pdf (19-7740 Rev 1, pp.2, 9, 18-20 Tables 6-8, p.31)"
          }
        }
