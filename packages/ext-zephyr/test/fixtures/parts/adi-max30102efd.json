          }
        }
      ],
      "traits": [
        {
          "type": "usage_note",
          "params": {
            "note": "7-bit address 0x57, fixed (slave ID 0b1010111; 0xAE write / 0xAF read). SCL 0-400 kHz, bus capacitance <= 400 pF. VIH >= 0.7 x VDD, VIL <= 0.3 x VDD, so the bus may be pulled up above VDD (6.0 V absolute maximum). SDA is open-drain and needs a pull-up (typically > 500 ohm); SCL is input only. Series resistors are optional. FIFO_DATA reads do not auto-increment the register pointer.",
            "source": "https://download.mikroe.com/documents/datasheets/MAX30102_datasheet.pdf (19-7740 Rev 1, pp.2, 4-5, 28-29 Table 17)"
          }
        }
      ]
    },
