<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE eagle SYSTEM "eagle.dtd">
<!-- ext-parts audit-helper fixture: a 30 x 20 mm board, one top header, one bottom (MR90) header, a plated
     mounting-hole footprint and a plain hole. Each pad's trace ends on the pad centre as Eagle places it. -->
<eagle version="9.6.2">
<drawing>
<board>
<plain>
<wire x1="0" y1="0" x2="30" y2="0" width="0" layer="20"/>
<wire x1="30" y1="0" x2="30" y2="20" width="0" layer="20"/>
<wire x1="30" y1="20" x2="0" y2="20" width="0" layer="20"/>
<wire x1="0" y1="20" x2="0" y2="0" width="0" layer="20"/>
<hole x="27" y="17" drill="3.2"/>
</plain>
<libraries>
<library name="fix">
<packages>
<package name="1X03">
<pad name="1" x="-2.54" y="0" drill="1"/>
<pad name="2" x="0" y="0" drill="1"/>
<pad name="3" x="2.54" y="0" drill="1"/>
</package>
<package name="SMD2">
<smd name="A" x="1" y="0.5" dx="0.6" dy="0.6" layer="1"/>
<smd name="B" x="2" y="-0.5" dx="0.6" dy="0.6" layer="1"/>
</package>
<package name="MOUNTINGHOLE_2.5_PLATED">
<pad name="P$1" x="0" y="0" drill="2.5" diameter="4"/>
</package>
</packages>
</library>
</libraries>
<elements>
<element name="JP1" library="fix" package="1X03" value="" x="15" y="2.54"/>
<element name="U1" library="fix" package="SMD2" value="CHIP" x="10" y="10" rot="MR90"/>
<element name="H1" library="fix" package="MOUNTINGHOLE_2.5_PLATED" value="" x="3" y="17"/>
</elements>
<signals>
<signal name="VCC">
<contactref element="JP1" pad="1"/>
<contactref element="U1" pad="A"/>
<wire x1="12.46" y1="2.54" x2="10.5" y2="11" width="0.2" layer="1"/>
</signal>
<signal name="GND">
<contactref element="JP1" pad="2"/>
<contactref element="H1" pad="P$1"/>
<wire x1="15" y1="2.54" x2="3" y2="17" width="0.2" layer="1"/>
</signal>
<signal name="SDA">
<contactref element="JP1" pad="3"/>
<contactref element="U1" pad="B"/>
<wire x1="17.54" y1="2.54" x2="9.5" y2="12" width="0.2" layer="1"/>
</signal>
</signals>
</board>
</drawing>
</eagle>
