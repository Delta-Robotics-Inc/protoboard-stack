    "untrustedWorkspaces": {
      "supported": false,
      "description": "Protoboard checks, builds and serves a project by running its code (protoboard.config.ts, its model files, and the project's own CLI when it has one), so it does not run in Restricted Mode. In a trusted window it still asks once per project before it runs that project's code."
    }
  },
