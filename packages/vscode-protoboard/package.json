    "configuration": {
      "title": "Protoboard",
      "properties": {
        "protoboard.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "A particular `protoboard` CLI to run. Empty (the default) lets Protoboard choose, in this order: the project's own installed `@protoboardai/cli` (from `npm install`, or links to the stack this extension carries), this setting, a stack copy in `~/.protoboard/stack` that matches the version the project pins, the stack carried by this extension. The project's own CLI always wins over this setting. A `.mjs`/`.js` file runs with `#protoboard.nodePath#`. **Protoboard: Show Log** says which one runs."
        },
        "protoboard.nodePath": {
          "type": "string",
          "default": "node",
          "scope": "machine",
          "markdownDescription": "The Node.js that runs the CLI. `node` (the default) lets Protoboard choose: a Node.js 22 or later on this window's `PATH`, else one found where Homebrew, nvm, Volta, fnm, mise or asdf put it (a VS Code started from the macOS Dock does not have your shell's `PATH`), else VS Code's own runtime, so a machine without Node.js works too. Set a full path (`which node` in a terminal) to choose one yourself. **Protoboard: Show Log** says which one runs."
        },
        "protoboard.dev.port": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "markdownDescription": "Port for a dev server the extension starts. Empty: 5180, or the next free port. A port given here must be free."
        },
        "protoboard.check.onSave": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Check again (`protoboard build`) when a file of a project that has been checked is saved."
        },
        "protoboard.check.onOpen": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Check the project (`protoboard build`, which runs every validator) when the window opens, so the Explorer and the DRC view are current."
        },
        "protoboard.libraries": {
          "type": "array",
          "default": [],
          "scope": "application",
          "items": {
            "type": "object",
            "required": [
              "id",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                "description": "Short id, shown with results and recorded in parts/origins.json."
              },
              "url": {
                "type": "string",
                "pattern": "^https?://",
                "description": "The library's URL (its discovery document is at <url>/.well-known/uhd-library)."
              },
              "authEnv": {
                "type": "string",
                "pattern": "^PROTOBOARD_[A-Z0-9_]+_TOKEN$",
                "description": "Name of the environment variable holding the library's read token, PROTOBOARD_<NAME>_TOKEN (not PROTOBOARD_CLOUD_TOKEN). Never the token itself."
              }
            }
          },
          "markdownDescription": "Your personal part libraries (`uhd-library/v1`), searched after the project's own (`libraries` in `protoboard.config.ts`). Kept in your user settings, never in the project; the CLI runs from VS Code see them as `PROTOBOARD_USER_LIBRARIES`. Credentials only as environment variable names (`authEnv`). Manage them from the Library view's **Manage Libraries**."
        },
        "protoboard.drc.revealOnOpen": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the **DRC** view in the panel when a Protoboard project opens."
        },
        "protoboard.inspector.revealOnSelection": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Bring the **Protoboard Inspector** to the front of the secondary side bar when a module or a link is selected in a viewer tab. The keyboard focus stays in the viewer. Turn it off to keep another view (an agent's chat) in front; **Inspect** in a module's right-click menu still shows it."
        },
        "protoboard.viewer.openOnFirstVisit": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Open the viewer at the top-level system the first time a Protoboard project is opened in a workspace, or appears in it (`protoboard init` run in the open folder). After that, VS Code restores the tabs that were open."
        },
        "protoboard.editor.codeLens": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show **Open in Viewer** above each module a `.uhd.ts` file defines (as the project's last build knows them)."
        },
        "protoboard.terminal.addCommand": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Add the `protoboard` command to this window's terminals (`~/.protoboard/bin` at the end of `PATH`), so you and your agent can run `protoboard check` in a project without installing anything else. In a project that has its own CLI the command runs that one. A `protoboard` already on your `PATH` stays first. **Protoboard: Add the protoboard Command to PATH** does the same for terminals outside VS Code."
        },
        "protoboard.agents.offerSetup": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Offer once, after the first sign-in or the first Protoboard project, to connect the agents found on this machine (Claude Code, Cursor, Codex and others) to Protoboard's MCP server. Nothing is changed without your choice per agent. **Protoboard: Open Settings** connects and disconnects them at any time."
        }
      }
    },
