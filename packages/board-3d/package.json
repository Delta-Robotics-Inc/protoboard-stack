    "directory": "packages/board-3d"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "py",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@protoboardai/board": "^0.2.2",
    "@protoboardai/board-scene": "^0.2.2",
    "@resvg/resvg-js": "2.6.2",
    "zod": "3.25.76"
  },
  "keywords": [
    "protoboard",
    "hardware",
    "pcb",
    "eda",
    "step",
    "3mf",
    "cad"
  ],
  "homepage": "https://protoboard.ai",
  "bugs": {
    "url": "https://github.com/Delta-Robotics-Inc/protoboard-stack/issues"
  }
}
