{
  "name": "@protoboardai/board-3d",
  "version": "0.2.2",
  "description": "Protoboard board 3D: the 3D model of a board (board body, seated component bodies, detail tiers) and its export as STEP, STL, 3MF and GLB with a sidecar and images. Runs in plain Node; the CAD runtime (OCCT) is optional, for re-reading STEP and placing part STEP models.",
  "license": "Apache-2.0",
  "author": "Delta Robotics, Inc.",
  "repository": {
    "type": "git",
