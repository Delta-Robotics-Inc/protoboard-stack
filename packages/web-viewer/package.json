{
  "name": "@protoboardai/web-viewer",
  "version": "0.2.3",
  "description": "The Protoboard viewer, for the browser and VS Code.",
  "license": "Apache-2.0",
  "author": "Delta Robotics, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Delta-Robotics-Inc/protoboard-stack.git",
    "directory": "packages/web-viewer"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json",
    "./vscode": "./src/vscode/index.ts",
    "./vscode/protocol": "./src/vscode/protocol.ts"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vite build -c vite.vscode.config.ts",
    "prepack": "npm run build",
    "build:vscode": "vite build -c vite.vscode.config.ts"
  },
  "dependencies": {
    "@deltarobotics/uhd-viewer": "^0.2.1",
    "@protoboardai/views": "^0.2.0",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.61.0",
    "react": "^19.2.8",
    "react-dom": "^19.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  },
  "keywords": [
    "protoboard",
    "hardware",
    "viewer",
    "diagram",
    "3d"
  ],
  "homepage": "https://protoboard.ai",
  "bugs": {
    "url": "https://github.com/Delta-Robotics-Inc/protoboard-stack/issues"
  }
}
