    {
      "key": "@protoboard/ext-hardware/fix-two-wiring-faults",
      "id": "fix-two-wiring-faults",
      "extension": "@protoboard/ext-hardware",
      "title": "Find and fix two wiring faults at once: the O4 powered from the pack, and the GNSS RX and TX swapped",
      "skills": [
        "system-compose",
        "system-review",
        "harness-author"
      ],
      "status": "ran",
      "budget": {
        "turns": 30,
